{
  "name": "miles-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute miles --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute miles --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute miles --remote --file=./seed.sql",
    "tail": "wrangler tail",
    "test": "npm run test:units && npm run test:e2e && npm run test:migrate && npm run test:api && npm run test:analytics && npm run test:patterns && npm run test:rules && npm run test:advice && npm run test:rss && npm run test:review && npm run test:wallet && npm run test:mcc && npm run test:statement && npm run test:banks && npm run test:other && npm run test:cardscan && npm run test:tiers && npm run test:platform && npm run test:tidy && npm run test:rulesets && npm run test:recommend && npm run test:actions && npm run test:ingest && npm run test:catalog && npm run test:recalculate && npm run test:onboarding && npm run test:rewards && npm run test:web",
    "test:units": "esbuild test/units.ts --bundle --loader:.sql=text --platform=node --format=esm --outfile=test/.units.mjs && node test/.units.mjs",
    "test:e2e": "esbuild test/e2e.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.e2e.mjs && node test/.e2e.mjs",
    "build": "npm --prefix web ci && npm --prefix web run build",
    "typecheck": "tsc --noEmit",
    "test:migrate": "esbuild test/migrate.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.migrate.mjs && node test/.migrate.mjs",
    "test:api": "esbuild test/api.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.api.mjs && node test/.api.mjs",
    "test:analytics": "esbuild test/analytics.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.analytics.mjs && node test/.analytics.mjs",
    "test:patterns": "esbuild test/patterns.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.patterns.mjs && node test/.patterns.mjs",
    "test:rules": "esbuild test/rules.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.rules.mjs && node test/.rules.mjs",
    "test:advice": "esbuild test/advice.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.advice.mjs && node test/.advice.mjs",
    "test:rss": "esbuild test/rss.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.rss.mjs && node test/.rss.mjs",
    "test:review": "esbuild test/review.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.review.mjs && node test/.review.mjs",
    "test:wallet": "esbuild test/wallet.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.wallet.mjs && node test/.wallet.mjs",
    "test:mcc": "esbuild test/mcc.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.mcc.mjs && node test/.mcc.mjs",
    "test:statement": "esbuild test/statement.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.statement.mjs && node test/.statement.mjs",
    "test:banks": "esbuild test/banks.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --external:pdfjs-dist --outfile=test/.banks.mjs && node test/.banks.mjs",
    "test:other": "esbuild test/other.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.other.mjs && node test/.other.mjs",
    "test:cardscan": "esbuild test/cardscan.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.cardscan.mjs && node test/.cardscan.mjs",
    "test:tiers": "esbuild test/tiers.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.tiers.mjs && node test/.tiers.mjs",
    "test:platform": "esbuild test/platform.ts --bundle --platform=node --format=esm --external:node:* --outfile=test/.platform.mjs && node test/.platform.mjs",
    "test:tidy": "esbuild test/tidy.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.tidy.mjs && node test/.tidy.mjs",
    "test:rulesets": "esbuild test/rulesets.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.rulesets.mjs && node test/.rulesets.mjs",
    "test:recommend": "esbuild test/recommend.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.recommend.mjs && node test/.recommend.mjs",
    "test:web": "npm --prefix web run build && esbuild test/web.ts --bundle --platform=node --format=esm --external:node:* --external:playwright --outfile=test/.web.mjs && node test/.web.mjs",
    "test:actions": "esbuild test/actions.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.actions.mjs && node test/.actions.mjs",
    "test:ingest": "esbuild test/ingest.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.ingest.mjs && node test/.ingest.mjs",
    "test:catalog": "esbuild test/catalog.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.catalog.mjs && node test/.catalog.mjs",
    "test:recalculate": "esbuild test/recalculate.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.recalculate.mjs && node test/.recalculate.mjs",
    "test:onboarding": "esbuild test/onboarding.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.onboarding.mjs && node test/.onboarding.mjs",
    "test:rewards": "esbuild test/rewards.ts --bundle --loader:.sql=text --platform=node --format=esm --external:node:* --outfile=test/.rewards.mjs && node test/.rewards.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "esbuild": "^0.24.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.131.0"
  }
}
